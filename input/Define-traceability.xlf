<xliff xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 http://docs.oasis-open.org/xliff/v1.2/os/xliff-core-1.2-strict.xsd" version="1.2" xmlns:xhtml="http://www.w3.org/1999/xhtml" xml:space="preserve" xmlns="urn:oasis:names:tc:xliff:document:1.2"><file original="course" datatype="plaintext" source-language="en-us"><body><trans-unit id="title"><source>Define Traceability</source></trans-unit><trans-unit id="description"><source><g id="Xa3R9640BPl7hA3J" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="2c898672-3d09-459a-8b3d-34a3a94b5287"><g id="gWnXmCPC4Fro4_hA" ctype="x-html-P"><g id="snnxR0TiyvIwNPEe" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="eZSncvAib9AOoB7Q" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="_8GsJ1HQHyNzi5zu" ctype="x-html-EM">Click </g><g id="uuytIA3KmRrmgzzl" ctype="x-html-STRONG"><g id="Ve4SrxpdApLECUHl" ctype="x-html-EM">START </g></g><g id="k8cbzd50VPgqzqny" ctype="x-html-EM">to begin.</g></g></g></g></g></source></trans-unit></body></file><file original="eMCWNps9SgLkE_qi-cTrMsRzHSNAYgYK" datatype="plaintext" source-language="en-us"><body><trans-unit id="title"><source>Define Traceability</source></trans-unit><trans-unit id="items|id:cm6rnxfiy04lj0fa52bpvfbf9|items|id:cldvkhgtc004v2a6gyj84tj7t|heading"><source><g id="VX_eC7ytYePUUiTb" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="9f56c699-2bcd-4c5c-b24e-48384cbed4f2"><g id="L-IRQ2bGo8oUBlAZ" ctype="x-html-P"><g id="KfPxpodao78y2PwE" ctype="x-html-SPAN" xhtml:style="font-size: 3.2rem"><g id="Mpbb0_AyCxAaFceA" ctype="x-html-SPAN" xhtml:style="color: rgb(255, 255, 255); text-decoration: inherit"><g id="LsNV4vot8-VecxKQ" ctype="x-html-STRONG">Introduction </g></g></g></g></g></source></trans-unit><trans-unit id="items|id:cm6rnxf6t001c0ddv9xnjcgot|items|id:claj4j9my000d356nxlcqkklf|caption"><source><g id="003h0iEi50xhGcRa" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="eba55d3f-d86d-4327-8ef0-de40d13418fb"/></source></trans-unit><trans-unit id="items|id:cm6rnxf6t001c0ddv9xnjcgot|items|id:claj4j9my000d356nxlcqkklf|paragraph"><source><g id="EEkMtTw4sR0iJBXD" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="46fe5874-456d-45d8-90ab-c341981b941b"><g id="RlEOYOwVVMsn7mzf" ctype="x-html-P"><g id="1PzKqz_ebR2JfZcB" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="SM9G1YuDz3y_-QdA" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">In this lesson, you will learn how to create and manage implement relations between system components using a traceability matrix. You'll learn to link both conceptual elements (Reference-Reference) and specific instances (Occurrence-Occurrence) within valid design contexts. The traceability matrix helps visualize these connections clearly for better design consistency and traceability.</g></g></g></g></source></trans-unit><trans-unit id="items|id:cm6tapw4g019n0d6z12v3cd9i|items|id:cldvk5gt500482a6g42exwkb6|heading"><source><g id="FTKJVhBzi3ovXTwA" ctype="x-html-P"><g id="8xW1Y17RavFUdVb7" ctype="x-html-STRONG"><g id="-QSr-h-JN4WEh_rY" ctype="x-html-SPAN" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:style="color: rgb(255, 255, 255); font-size: 32px;">Learning Objectives<g id="WvVnblx2DUKbO1AZ" ctype="x-html-BR"/></g></g></g></source></trans-unit><trans-unit id="items|id:cm6tapvs7008u0dedcvq899u7|items|id:clahzz4hk0029356nq2ay0wzi|paragraph"><source><g id="zEivdklskzw0GtDL" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="10dd26e0-198f-4d9e-8918-50552b81df8e"><g id="Bh90Bm1JNwQDz9ab" ctype="x-html-P"><g id="qBdZ4JMaoPULIrzs" ctype="x-html-SPAN" xhtml:style="font-size: 2.2rem"><g id="VjWVHsFFDvypvkzP" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="eJhNc85125G4soZW" ctype="x-html-STRONG">After completing this lesson, you will be able to:</g></g></g></g><g id="0ejb-AJmqb4zLDh5" ctype="x-html-UL"><g id="RsjLIZjla0bfj7tc" ctype="x-html-LI"><g id="3qWTY5HKVfxA9y3z" ctype="x-html-P"><g id="_ml-7j2bJKvLUXpW" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="z5BAs4XtKHKLGDr7" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">Create implement relations for the logical and functional instances</g></g></g></g><g id="6L96k7i2ILSlbPIx" ctype="x-html-LI"><g id="8ehqIlWfOqEOgqAo" ctype="x-html-P"><g id="8J1dKWyk2CcNHJaX" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="yRGNHlw346l6CdOI" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">Utilize traceability matrix for creating relations between nodes</g></g></g></g></g></g></source></trans-unit><trans-unit id="items|id:cme9hh36a003s07gp1ewzhxum|items|id:cldvk5gt500482a6g42exwkb6|heading"><source><g id="EvaWuaxMCI7sQ_Od" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="57ad4be6-80ba-4c4e-9159-a9fb788ac41b"><g id="SoH8AwFS9EkF7k5U" ctype="x-html-P"><g id="miT81yR60vMXspLC" ctype="x-html-SPAN" xhtml:style="font-size: 3.2rem"><g id="-_cYsYLIGw5JuRAZ" ctype="x-html-SPAN" xhtml:style="color: rgb(255, 255, 255); text-decoration: inherit"><g id="cT6AbujvGrv-14SI" ctype="x-html-STRONG">Important Terminologies/Concepts</g></g></g></g></g></source></trans-unit><trans-unit id="items|id:cme9hh36a003u07gp5ate8xmk|items|id:clbbwgkdp0049356nrw9vrqpr|paragraph"><source><g id="c9ppR498uPaPptTd" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="c27dde9a-06a3-4379-b448-11035b4d37bc"><g id="pdEcqnASnzXZpwAw" ctype="x-html-P" xhtml:style="text-align: center"><g id="vnCEyxc6dcYvvpQC" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="etd4I6IZ4c2EpeYP" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="IngPgI4S_ck8IUUJ" ctype="x-html-EM">Click the numbers or use navigational arrows to learn more.</g></g></g></g></g></source></trans-unit><trans-unit id="items|id:cme9hh2ls00030796ht7j9oil|settings|stepLabel"><source>Concept</source></trans-unit><trans-unit id="items|id:cme9hh2ls00030796ht7j9oil|items|id:clai0ph93004m356noumyu2by|description"><source><g id="6Mhb6LDFNxxI64g2" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="ed1d6533-4e1a-4189-bd3e-1608a10fd7f0"><g id="bmZpd2cZva4A2iPY" ctype="x-html-P" xhtml:style="text-align: left"><g id="lo5vzofC-SH121eF" ctype="x-html-SPAN" xhtml:style="font-size: 2.2rem"><g id="vB2kMwW8FE025yx-" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="UJLCpuAwfKc-D8cd" ctype="x-html-STRONG">Implement Relation</g></g></g></g><g id="Xf_H_9Xt2eFjCTFy" ctype="x-html-P" xhtml:style="text-align: left"><g id="PtuL_3Y3nGOIki-a" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="pdrUND-NwsSFg5do" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">In the systems architecture domain, implement relation is a relation or link used to connect requirements, functions, logical components and physical components. The implement relation identifies the purpose of these elements. Implement relations are always created from a lower-level abstract category to a higher-level abstract category:</g></g></g><g id="aUoMvmt-NHwHCojT" ctype="x-html-UL"><g id="Tn5PCnqv7LXDq1EM" ctype="x-html-LI"><g id="32YTdUoNEYHy-pq-" ctype="x-html-P"><g id="KrLDMbZrrJGl4ovC" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="c_P_mxWA0LYjuqnC" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">A physical component implements a logical component (or a requirement)</g></g></g></g><g id="K0PFP12Hlks477x3" ctype="x-html-LI"><g id="y62jp4gDrGFw5DhL" ctype="x-html-P"><g id="_bRrHA33IJuNz-RF" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="3Eefykg4rf3D0Cng" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">A logical component implements a function (or a requirement)</g></g></g></g><g id="S8AfR_nJxNsFS47S" ctype="x-html-LI"><g id="Dbn8WIqUs7VNoxSk" ctype="x-html-P"><g id="-QUxnEwpzImMGZcg" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="9MCroMWiCK4yko2t" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">A function implements a requirement.</g></g></g></g></g><g id="KKIWJe7ZGbo7N--p" ctype="x-html-P"><g id="hTWv3BVZpUThUnjF" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="huBxIEoLA6oYIkPP" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">You can create implement links inside the same level:</g></g></g><g id="TYHhp74SguEac9Pn" ctype="x-html-UL"><g id="aAbZJeFKGUA3izJP" ctype="x-html-LI"><g id="-WIZrFHHQ7Lwz4-8" ctype="x-html-P"><g id="Drv3VdJsLUa9x5dO" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="Dd3FGsBKhZSZ6LXU" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">Between two functions</g></g></g></g><g id="JO5881eV7ClPmokl" ctype="x-html-LI"><g id="7LHKB_iXo3sH85cL" ctype="x-html-P"><g id="vd7s9njJpJ4NbmqC" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="xL7ym3dmeYsOdBXB" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">two logical components</g></g></g></g><g id="alKZppo5uO_5uPc9" ctype="x-html-LI"><g id="bFeNNyNn3drIS0AS" ctype="x-html-P"><g id="K1vUW_ubmZc-ppf5" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="P8e3IzZ0Lhrv3QWY" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">two flows/types.</g></g></g></g></g><g id="hX4A7vsbZEPeew8E" ctype="x-html-P" xhtml:style="text-align: left"/></g></source></trans-unit><trans-unit id="items|id:cme9hh2ls00030796ht7j9oil|items|id:clai0ph93004n356nqatrbzqd|description"><source><g id="HUCBLzOxwDkX7tN_" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="5a0defc3-6204-4c74-9fdc-5f0c6a9b6dd7"><g id="sTXJLv-fYl9EDsZl" ctype="x-html-P"><g id="GFlAwObEl2sF5uJ9" ctype="x-html-SPAN" xhtml:style="font-size: 2.2rem"><g id="f17pIYIzsHykAhyl" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="XCvmqBeR_lJQ7MKS" ctype="x-html-STRONG">Implement Link</g></g></g></g><g id="39FENN9dAv-aZt6k" ctype="x-html-OL"><g id="shoorXXsNDPwJDuq" ctype="x-html-LI"><g id="NcQz3VSPoWIltku3" ctype="x-html-P"><g id="_gqp7bDd8J21zkFA" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="jtBJSPO_Kw5k2f9P" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">An implement link joins different objects of the RFLP structure:</g></g></g><g id="CIYAyCRmlRkK1br1" ctype="x-html-OL"><g id="VkCr6TUvYIDvoJvw" ctype="x-html-LI"><g id="9tmaOwRO5AkImjB1" ctype="x-html-P"><g id="48_jYGxdsGxPkChN" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="tF2FC_bEtpTJg5jW" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">It defines the design context.</g></g></g></g><g id="hiPmeD5yWdSwT2YF" ctype="x-html-LI"><g id="dAvuciepy2CWpCB_" ctype="x-html-P"><g id="BQvrl608eNlIgMlA" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="AOMHIwt79ji25CFh" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">It assures the traceability from the requirement to the final product.</g></g></g></g><g id="zB8_4eTSMbrRWTL9" ctype="x-html-LI"><g id="Hck4raBon6mRhW6x" ctype="x-html-P"><g id="q_Hm5MnoMq71NkdF" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="etptzu9Rf4mUIm2D" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">It must be defined between two different roots.</g></g></g></g></g></g><g id="O8loztNywMT0rLkm" ctype="x-html-LI"><g id="3KumAC2HHbCmBXG4" ctype="x-html-P"><g id="gjMHulsMP8vRJzu_" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="l6aiGyGjR7GTx8Lp" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">Implements links are displayed in the tree (in the implementing object node) and in the work area (on both implemented and implementing objects)</g></g></g><g id="YuJlQr1O5x11QvQl" ctype="x-html-OL"><g id="uP8FCD1Sv8qGKr4E" ctype="x-html-LI"><g id="Wa2brnjrslb5mXKy" ctype="x-html-P"><g id="lmQMLUs9EPGcN9v5" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="GMLMiwoFRIky7Rwi" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="mXedkf5vHb2icgz7" ctype="x-html-STRONG">In the tree</g>, click the implement link to highlight the implementing and implementing objects.</g></g></g></g><g id="UJyGYpBtTB2_1foa" ctype="x-html-LI"><g id="ikPxhphTfud9F2n6" ctype="x-html-P"><g id="gop6VnBizKP_hk32" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="28VoO0i8zoEfYyx0" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="f0hIe_Wigeq5XQqU" ctype="x-html-STRONG">In the work area</g>, click the icon to display the implementing or implemented object.</g></g></g></g></g></g></g><g id="LSbscBFTpe-BwPGn" ctype="x-html-P"/></g></source></trans-unit><trans-unit id="items|id:cme9hh2ls00030796ht7j9oil|items|id:clai0uj3k004p356noow28tn3|description"><source><g id="eC-M4JECg2iaQ_6g" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="96d89cfe-162c-4deb-b51b-b86ff3b175b2"><g id="kBWl2tWXyVKsxUj7" ctype="x-html-P"><g id="rckXOPfLtvaPx_Qe" ctype="x-html-BR" xhtml:class="break-when-trailing"/><g id="RMVdrc3sBQmoEb8u" ctype="x-html-SPAN" xhtml:style="font-size: 2.2rem"><g id="wfr_3fsqD5Dz11nZ" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="y1nw2RKRbtEC0TGD" ctype="x-html-STRONG">Types of Implement Link</g></g></g></g><g id="-gS-bQYQ9XMolFcY" ctype="x-html-OL"><g id="tg4ME84CGXTNvjRc" ctype="x-html-LI"><g id="WwHBrAbujimgB4bJ" ctype="x-html-P"><g id="6S2WLKfGekttnpHQ" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="vRqByOtktvSrwJUm" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">There are two types of implement Links:</g></g></g><g id="qYyBZUvRXW0mmyLg" ctype="x-html-OL"><g id="I85KyTm0gF3vkLIl" ctype="x-html-LI"><g id="9dc0k7lEhcZDyGEw" ctype="x-html-P"><g id="ICtlaQ5bLvQ1adbJ" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="lOfufDPAGLIIc3Hq" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="U1Q9PtkTaOkt63QH" ctype="x-html-STRONG">Reference-Reference Link (Conceptual Link):</g> A Reference-Reference Link is a connection between two main design elements in a system.</g></g></g></g><g id="dEa4P3wW1_ygRJeE" ctype="x-html-LI"><g id="iQx2f3LV52nQA65L" ctype="x-html-P"><g id="8EH27w4MvFWeWVW9" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="nqTTf2uN_DP-CcJP" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="Sey7ZJfeFQ1bdx6w" ctype="x-html-STRONG">Occurrence-Occurrence Link (Implentation Link): </g>An Occurrence-Occurrence Link is a connection between two specific instances (or "occurrences") of system components that are already linked at a higher, more general level by a Reference-Reference Link.</g></g></g></g></g></g><g id="LSj9hwdJUv_ILagv" ctype="x-html-LI"><g id="ObdsfrAfTUEczIEI" ctype="x-html-P"><g id="ZcFCb1kmY6N4FpGH" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="xKNdN2ZGN5uY19WL" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="zdp-3rxqfD9FWYcp" ctype="x-html-STRONG">Occurrence-Occurrence (Occ-Occ)</g> links can only be created within a valid context, which must first be established by a <g id="qZGhUihUSKrGc0nf" ctype="x-html-STRONG">Reference-Reference (Ref-Ref)</g> link.</g></g></g></g><g id="Lq5zqAac4MNbSsAX" ctype="x-html-LI"><g id="coOXmf__1Q3As0tG" ctype="x-html-P"><g id="88oUsnSOd73F4nAh" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="vNCHdCQazvf_B-cb" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">If no <g id="TQ2Fr6ssUM3K03vC" ctype="x-html-STRONG">Ref-Ref</g> link exists between the reference components, then <g id="yYGQ6ZmFczsSL3kL" ctype="x-html-STRONG">Occ-Occ</g> links between their instances cannot be defined.</g></g></g></g><g id="kSze-MHfLxtN9lly" ctype="x-html-LI"><g id="uyj0s42IvYB9s6MX" ctype="x-html-P"><g id="nSRCje2huDFYHVLC" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="jcDj6g8b0u5vHM9s" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="DRG2vzFp067ScAGJ" ctype="x-html-STRONG">Example (Refer the Image):</g> A <g id="FzDPQxY-lSr4KzMr" ctype="x-html-STRONG">reference-reference link</g> has been created between F2 and L2. An <g id="GQ-NzBZMyQtbA0Ha" ctype="x-html-STRONG">occurrence-occurrence link</g> is created between F3.1 and L3.1 in the context of F2-L2. The sub system F2-L2 is instantiated under F0 and L0 and an <g id="8AcxgngkkpbLsEft" ctype="x-html-STRONG">occurrence-occurrence link</g> is created between F2.1 &amp; L2.1 in the context of F0-L0.</g></g></g></g></g></g></source></trans-unit><trans-unit id="items|id:cmcvwce9h00e53j7emmvrk9ef|items|id:cmcvwce9h00e63j7e5rch8v3j|heading"><source><g id="rA-nDuNt-MHRSTOO" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="14eb5595-c631-4fe6-a8f4-09951f8d2956"><g id="odJQc1z5vqtWA5zI" ctype="x-html-P"><g id="NZPOYYNeoxRXtacT" ctype="x-html-SPAN" xhtml:style="font-size: 3.2rem"><g id="o8trTO3sS57OWoh1" ctype="x-html-SPAN" xhtml:style="color: rgb(255, 255, 255); text-decoration: inherit"><g id="_0OCQ2XwsxzPup1b" ctype="x-html-STRONG">General Terms</g></g></g></g></g></source></trans-unit><trans-unit id="items|id:cme9hap5h000p078p51ps7pcq|items|id:claj4meas000s356ntbrgn594|paragraph"><source><g id="FrkHXXFAxtppookL" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="bf3d80e1-a419-461b-8bb1-34b1ffa0bc09"><g id="I5WNgBx9Obi80FaJ" ctype="x-html-P"><g id="5JizzQIl4WOwTBmF" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="TK2QwSfkBz5VGh94" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="a4DKtJu_3vN8UakT" ctype="x-html-EM">Click the tabs to know more.</g></g></g></g></g></source></trans-unit><trans-unit id="items|id:cmb0n3fa200gr07e55blq1dw3|items|id:clkmfbdtd00062a6u1pq0r7r1|title"><source>Logical Port</source></trans-unit><trans-unit id="items|id:cmb0n3fa200gr07e55blq1dw3|items|id:clkmfbdtd00062a6u1pq0r7r1|description"><source><g id="SgRD_pPhbAGTKVmH" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="d4b4455f-4d0d-4202-8cc0-5b7a567e8d0b"><g id="3l9bsMdil4XSkE4O" ctype="x-html-P"><g id="aTJWCDiEeiYg0vjj" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="ep6MI7KAz6iqWk6G" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">A logical port is an interface within a system's logical architecture that facilitates communication between different logical components. It helps define how data or signals flow between elements before physical implementation.</g></g></g><g id="_opm4OLazmgPVrMC" ctype="x-html-OL"><g id="WaLi9306aaxw4lxV" ctype="x-html-LI"><g id="RhOwvmZtSDPT1BJf" ctype="x-html-P"><g id="Fdut5XwjrG3tMGsi" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="ZYaaCe7nm1tMDS45" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="zuVljD2q9tiHl2X0" ctype="x-html-STRONG">Input Logical Port</g> – Receives data or signals from another logical component to process within the system.</g></g></g></g><g id="fUABBaGyEME6Pv6A" ctype="x-html-LI"><g id="VQt27IwmhkpgHvKb" ctype="x-html-P"><g id="IyaHsqIhIToKt1A_" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="KjsnBFpO9QK34xKn" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="IkLppsc3wpsd-2yN" ctype="x-html-STRONG">Output Logical Port – </g>Sends processed data or signals to another logical component for further operations.</g></g></g></g><g id="rA7ETC6_4-CXK_tv" ctype="x-html-LI"><g id="E6nQXRwUy4azCdpP" ctype="x-html-P"><g id="YoN5RUYigXYWTX5x" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="Ii2bNMDuLmdFqpFJ" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="_uboq1DwQWsASi9Z" ctype="x-html-STRONG">Bidirectional Logical Port – </g>Allows data exchange in both directions between connected logical components.</g></g></g></g></g></g></source></trans-unit><trans-unit id="items|id:cmb0n3fa200gr07e55blq1dw3|items|id:clkmfbdtd00072a6uzrbd3c7s|title"><source>Logical Connection</source></trans-unit><trans-unit id="items|id:cmb0n3fa200gr07e55blq1dw3|items|id:clkmfbdtd00072a6uzrbd3c7s|description"><source><g id="QjZYc4l90f1wDkx9" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="a3f5c363-9a7a-4157-9cee-c3b169f963c2"><g id="nDOUyhqVjBrsbaw6" ctype="x-html-P"><g id="2waWPZpSFVfTE2rX" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="_5xJBKCJEc3WM6Hg" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">A logical connection defines the interaction between logical components within a system's logical architecture. It establishes how data, signals, or control flows between elements before physical implementation.</g></g></g></g></source></trans-unit><trans-unit id="items|id:cmb0n3fa200gr07e55blq1dw3|items|id:cmcaa50x700bq3j7dg3epyrxc|title"><source>Traceability Matrix</source></trans-unit><trans-unit id="items|id:cmb0n3fa200gr07e55blq1dw3|items|id:cmcaa50x700bq3j7dg3epyrxc|description"><source><g id="qki-YF1vVucvRKp2" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="5d97e16f-08cc-488e-b997-089ba4f7a9df"><g id="36Xd3B2xemLNaloS" ctype="x-html-P"><g id="zwVS28fFCwHLGCrj" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="E_dmaCpHFRdW5YQm" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">The Traceability Matrix shows implement relations between two structures, allowing you to create, edit, or delete these links within the editor.</g></g></g></g></source></trans-unit><trans-unit id="items|id:cmb0n3fa200gr07e55blq1dw3|items|id:clkmfbdtd00082a6usoxfh797|title"><source>Spreadsheet Editor</source></trans-unit><trans-unit id="items|id:cmb0n3fa200gr07e55blq1dw3|items|id:clkmfbdtd00082a6usoxfh797|description"><source><g id="HxMqTuX0QtlTlOkC" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="6e52e4e0-7989-4d90-871c-764537c433a3"><g id="MaUyPhHbyxAZF1-9" ctype="x-html-P"><g id="D8jPSjg1gZX63r4-" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="4d09f45OC61JX6Dx" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">The <g id="ra0Jbk4YTRDSLjdq" ctype="x-html-STRONG">3D</g>EXPERIENCE platform allows users to create logical components using the Spreadsheet Editor. In the Functional &amp; Logical Design app, at least one logical component is required before accessing the Spreadsheet Editor. The spreadsheet follows a 2D layout and resembles an Excel sheet. Changes made in either the Functional &amp; Logical Design tab or the Spreadsheet Editor are synchronized. The Spreadsheet Editor serves as a general editing tool, compatible with other applications like electrical, piping, and tubing design.</g></g></g></g></source></trans-unit><trans-unit id="items|id:cm9rzxoqd07bq07bt98dhfqlc|items|id:ckkmg43v0002g3q6cnlmbggpv|caption"><source><g id="pOLystWhW-_UKb5Q" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="67c398f2-4627-4d15-b210-5a78dce40dd3"><g id="Ydod3kquueR9_iow" ctype="x-html-P"><g id="khijnmx7wT6ANKUf" ctype="x-html-SPAN" xhtml:style="font-size: 3.2rem"><g id="XmMG9gFf3CEo7yWl" ctype="x-html-SPAN" xhtml:style="color: rgb(255, 255, 255); text-decoration: inherit"><g id="GAIkakXaoD_oB-Tg" ctype="x-html-STRONG">Activity</g></g></g><g id="enpyhwG-nD9QqcWO" ctype="x-html-SPAN" xhtml:style="color: rgb(255, 255, 255); text-decoration: inherit"><g id="7NWz-A4JDdWoqXSj" ctype="x-html-STRONG">: Creating Implementation Link using Traceability Matrix</g></g></g><g id="dGFAbviaiOKT-mdy" ctype="x-html-P"/></g></source></trans-unit><trans-unit id="items|id:cm9rzxoqd07br07btdmuveh2i|items|id:claj77zyl002i356nbukh2jl9|paragraph"><source><g id="GptPUrUoVU4ivWA8" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="c18ce4f4-7eac-4955-b2d5-c80bd64e126d"><g id="8PE0Ca-0llrUa8-n" ctype="x-html-P"><g id="U-QCIqPYirGN2XZN" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="VOXLlHwkC_Vuv7qO" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">In this activity, you will learn by performing the steps.</g></g></g><g id="LkHmlt2XU583cVgd" ctype="x-html-P"><g id="BnMYxtjaY1aHS8M9" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="DGwM5je0hl4cORoC" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="DHFQjOoP9J1N8S9r" ctype="x-html-SPAN" xhtml:style="background-color: rgb(255, 255, 255)">Download the data given below to perform the activity.</g></g></g></g></g></source></trans-unit><trans-unit id="items|id:cm9rzxo2h00uk07ah9k6md121|items|id:clbqcd69p0089356nuv32pji6|title"><source>Step 1</source></trans-unit><trans-unit id="items|id:cm9rzxo2h00uk07ah9k6md121|items|id:clbqcd69p0089356nuv32pji6|description"><source><g id="GKQTKzO-kSWoK0UL" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="446485d9-7c81-4098-8935-28b2feb3479f"><g id="zDFxIb3AEMT8Pta9" ctype="x-html-P"><g id="JZfUv8YOXoy84jWH" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="D0aNmAqG7WARszFk" ctype="x-html-STRONG">Implement relations between references and use the traceability matrix</g></g></g><g id="1OJAKmQS6khZ0AbH" ctype="x-html-P"/><g id="cI2Pc-56rJA3K1ry" ctype="x-html-P"><g id="utGEyRsnF1ZBlnMU" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="qpZp86vxY4eK2aTO" ctype="x-html-EM">Click Play to begin.</g></g></g></g></source></trans-unit><trans-unit id="items|id:clgezpt8d000c129newkv7c91|items|id:clakkvfbz000k356n81pl635k|caption"><source><g id="0Y5bMALPZ-AuRjs-" ctype="x-html-P"><g id="JcIjJR1ikEX0QZo5" ctype="x-html-STRONG">Knowledge Check<g id="CBohDwRsaI1OEaEh" ctype="x-html-BR"/></g></g></source></trans-unit><trans-unit id="items|id:clgezq30703de13a2ewnseikf|items|id:clanfe3ck001g356n9qu60jhs|title"><source><g id="hjErKCjuLvtUfxvF" ctype="x-html-DIV" xmlns:xhtml="http://www.w3.org/1999/xhtml" xhtml:data-editor-id="7b337736-4072-49df-b1fb-bcdfd16f97b3"><g id="OnjZAcQxzm5GlguS" ctype="x-html-P"><g id="RiQSTMlYQMm-6EGY" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="xc_KHFejs2HIIpLI" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="dcomQFbPVOCSgcSC" ctype="x-html-STRONG">Question 1/2</g></g></g></g><g id="QyvZP0WprvSeR1i0" ctype="x-html-P"/><g id="DcEK2qJf-OMHDX5U" ctype="x-html-P"><g id="v8H8djShCccDNxkq" ctype="x-html-SPAN" xhtml:style="font-size: 1.8rem"><g id="C7L92D7LG2zdLvWd" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit">Which of the following relations can be created using traceability matrix?</g></g></g><g id="iU05ySnsV0p8Re8y" ctype="x-html-P"/><g id="TFuIistek3S_mAA_" ctype="x-html-P"><g id="7bOefyHTO7W-OmVo" ctype="x-html-SPAN" xhtml:style="font-size: 1.7rem"><g id="UQr6OYhHBEu9Mwmx" ctype="x-html-SPAN" xhtml:style="color: rgb(0, 86, 134); text-decoration: inherit"><g id="dOs_uqKUdTHXQGJp" ctype="x-html-EM">Select the correct option and click </g><g id="ZSU5BR1as9B2-ttU" ctype="x-html-STRONG"><g id="AJbfkiDo